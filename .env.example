# Copy to .env for local dev. Never commit .env.

# Claude API key from console.anthropic.com (optional locally: the app degrades gracefully without it)
ANTHROPIC_API_KEY=

# Login password hash: `uv run python -m app.hashpw`. Leave empty locally to skip login.
# Use single quotes: the hash contains $ characters.
APP_PASSWORD_HASH=''
# Any long random string: `python3 -c "import secrets; print(secrets.token_urlsafe(32))"`
SESSION_SECRET=

USER_TZ=Africa/Lagos
# LLM_MODEL=claude-sonnet-5-5
# LLM_FAST_MODEL=claude-haiku-4-5
